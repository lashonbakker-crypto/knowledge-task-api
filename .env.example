# Documentation only: the application reads process environment variables.
# Use private, independent access tokens. These examples are public demo values.
KTA_KEYS_JSON={"alice":{"key":"demo-alice-local-only","role":"user"},"admin":{"key":"demo-admin-local-only","role":"admin"}}
KTA_DATABASE=data/knowledge.sqlite3

# Per claimed attempt; normal server and standalone worker read this value.
KTA_PROCESSING_SECONDS=300

# Admission limits count queued + running tasks, including delayed retries.
KTA_MAX_PENDING_PER_TENANT=100
KTA_MAX_PENDING_TOTAL=1000
